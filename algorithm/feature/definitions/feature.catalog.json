{
  "schema_version": 1,
  "catalog_version": 2,
  "description": "Canonical, implementation-independent features available to OpenRec rank models.",
  "policies": {
    "entity_profile_v1": {
      "as_of": "Latest entity mutation whose occurred_at is not later than the requested snapshot time.",
      "time": {"basis": "event_time", "unit": "epoch_seconds", "timezone": "UTC"},
      "identity": {"key": "entity id", "mutation_order": "occurred_at then business timestamp"},
      "invalid_input": {"missing_entity_id": "reject", "missing_value": "use feature default"}
    },
    "event_behavior_v1": {
      "as_of": "Only events with event.time less than or equal to the requested snapshot time are visible.",
      "time": {"field": "event.time", "basis": "event_time", "unit": "epoch_seconds", "timezone": "UTC", "window_boundary": "[as_of-window, as_of]"},
      "identity": {"deduplication_key": "event.event_id", "fallback": "user_id,item_id,scene,type,time,trace_id", "trace_id_semantics": "recommendation or impression context; not an action identity", "mutation_order": "occurred_at; DELETE wins ties"},
      "invalid_input": {"missing_user_id": "reject", "missing_item_id": "reject", "invalid_time": "reject", "invalid_numeric_value": 0, "empty_scene": "treat_as_missing"}
    }
  },
  "features": [
    {"id":"user.country","definition_version":1,"entity":"user","group":"profile","name":"country","description":"Country associated with the user at the snapshot time.","value_type":"string","shape":"categorical","source":{"logical_entity":"user","field":"country"},"policy":"entity_profile_v1","default":"","materialization":{"online":true,"offline":true,"backfillable":true},"status":"stable"},
